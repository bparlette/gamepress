{
  "_note": "Recipes for the synthetic sound effects `gamepress drive` mixes from a game's event log. Each is an ffmpeg aevalsrc expression of time t. Add your own, or map an event name to a file path in the plan's audio.map.",
  "boom":   { "d": 0.6,  "gain": 1.0, "expr": "sin(2*PI*55*t*exp(-2.2*t))*exp(-4.5*t)*0.9+(random(0)*2-1)*exp(-14*t)*0.4" },
  "crunch": { "d": 0.18, "gain": 0.7, "expr": "(random(0)*2-1)*exp(-22*t)" },
  "whoosh": { "d": 0.3,  "gain": 0.6, "expr": "(random(0)*2-1)*sin(PI*t/0.3)*0.7" },
  "splat":  { "d": 0.22, "gain": 0.7, "expr": "sin(2*PI*180*t*exp(-5*t))*exp(-12*t)" },
  "flip":   { "d": 0.55, "gain": 0.8, "expr": "sin(2*PI*(90+520*t)*t)*exp(-3*t)" },
  "alarm":  { "d": 0.22, "gain": 0.4, "expr": "(gt(sin(2*PI*(if(lt(t,0.1),660,440))*t),0)*2-1)*0.5*exp(-5*t)" },
  "ding":   { "d": 0.5,  "gain": 0.6, "expr": "sin(2*PI*1320*t)*exp(-7*t)" },
  "pop":    { "d": 0.1,  "gain": 0.6, "expr": "sin(2*PI*(400+3000*t)*t)*exp(-30*t)" },
  "hit":    { "d": 0.16, "gain": 0.8, "expr": "sin(2*PI*120*t*exp(-8*t))*exp(-18*t)+(random(0)*2-1)*exp(-40*t)*0.5" }
}
