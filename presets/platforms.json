    ],
    "video": { "id": "trailer", "file": "trailer.mp4", "w": 1920, "h": 1080, "fps": 30, "maxSeconds": 120, "from": "trailer", "note": "H.264 MP4. Steam wants gameplay in the first seconds." }
  },
  "itch": {
    "label": "itch.io",
