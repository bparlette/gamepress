      { "id": "banner",      "file": "banner.png",        "w": 1920, "h": 540,  "from": "hero", "fit": "cover", "optional": true, "note": "Page header image (profile/page theme)." },
      { "id": "screenshot",  "file": "screenshot_{n}.png","w": 1280, "h": 720,  "from": "shots", "fit": "cover", "min": 3, "max": 10, "note": "itch shows 3 to 5 prominently." }
    ],
    "gif": { "id": "cover_gif", "file": "cover.gif", "w": 630, "h": 500, "fps": 15, "maxMB": 3, "maxSeconds": 6, "from": "gif", "note": "Animated cover, max 3 MB." },
    "video": { "id": "trailer", "file": "trailer.mp4", "w": 1920, "h": 1080, "fps": 30, "maxSeconds": 90, "from": "trailer", "note": "Upload to YouTube/Vimeo and paste the link on the page; itch embeds it." }
  },
