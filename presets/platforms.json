{
  "_note": "Store asset specs as of late 2025. Stores change them: verify against the store's current docs before uploading, and edit this file (not the code) when they do. fit: cover = scale and crop to fill (focus x,y picks what stays); blurpad = whole frame centred over a blurred copy of itself (for portrait art from landscape shots); contain = letterbox.",
  "steam": {
    "label": "Steam (Steamworks store page)",
    "assets": [
      { "id": "header_capsule",   "file": "header_capsule.png",   "w": 460,  "h": 215,  "from": "hero", "fit": "cover", "note": "Store page header and the main discovery capsule. Put the logo in it." },
      { "id": "small_capsule",    "file": "small_capsule.png",    "w": 231,  "h": 87,   "from": "hero", "fit": "cover" },
      { "id": "main_capsule",     "file": "main_capsule.png",     "w": 616,  "h": 353,  "from": "hero", "fit": "cover", "note": "Top of the store front page when featured." },
      { "id": "vertical_capsule", "file": "vertical_capsule.png", "w": 374,  "h": 448,  "from": "hero", "fit": "blurpad" },
      { "id": "page_background",  "file": "page_background.jpg",  "w": 1438, "h": 810,  "from": "hero", "fit": "cover", "note": "Steam darkens it; keep the subject toward the edges." },
      { "id": "library_capsule",  "file": "library_capsule.png",  "w": 600,  "h": 900,  "from": "hero", "fit": "blurpad" },
